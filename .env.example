# =============================================================================
# Variáveis de ambiente do projeto Libertadores 2026
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com as suas chaves.
# O arquivo `.env` NUNCA deve ser commitado (já está no .gitignore).
#
# No GitHub, configure as mesmas variáveis em:
#   Settings → Secrets and variables → Actions → New repository secret
# =============================================================================

# Chave da Bzzoiro Sports Data (odds 1X2, multi-bookmaker)
# Obtenha em: https://sports.bzzoiro.com/register/ (gratuita)
BSD_API=sua_chave_bzzoiro

# Chave da API Futebol (estatísticas detalhadas, árbitros, escalações)
# Obtenha em: https://api-futebol.com.br (plano gratuito disponível)
API_FUTEBOL_KEY=sua_chave_api_futebol
